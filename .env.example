# ==============================================================================
# PG-PREP ARENA Environment Variables
# ==============================================================================

# Database Connection (Neon, Supabase, Render, Railway, or local PostgreSQL)
# For free cloud PostgreSQL (e.g. Neon.tech), set DATABASE_URL:
# DATABASE_URL="postgresql://username:password@ep-xyz.aws.neon.tech/neondb?sslmode=require"

# Alternatively, configure via individual Cloud SQL / PostgreSQL variables:
SQL_HOST="localhost"
SQL_PORT=5432
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="password"

# Optional Gemini AI API key for AI-driven clinical reasoning & explanations
GEMINI_API_KEY=""

# Optional Public URL for self-referential links & CORS
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="production"


